[Unit]
Description=Export per-DIMM ECC/MCE state for the DIMM Error Monitor widget
Documentation=https://github.com/boeroboy/dimm-mce-monitor
# rasdaemon is the preferred data source; the exporter degrades to EDAC sysfs
# without it, so this is Wants rather than Requires.
Wants=rasdaemon.service
After=rasdaemon.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/dimm-mce-export
Nice=10
IOSchedulingClass=idle

# Needs root only to read /var/lib/rasdaemon (0700) and to run dmidecode.
# Everything else is locked down.
ProtectSystem=strict
ProtectHome=yes
RuntimeDirectory=dimm-mce
RuntimeDirectoryMode=0755
# Without this systemd removes /run/dimm-mce the instant this oneshot exits,
# deleting the snapshot it just wrote.
RuntimeDirectoryPreserve=yes
ReadOnlyPaths=/var/lib/rasdaemon
# NOT PrivateNetwork: an empty net namespace hides every interface, so the
# collector would report zero network ports while claiming success.
PrivateTmp=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=CAP_SYS_RAWIO CAP_DAC_READ_SEARCH
